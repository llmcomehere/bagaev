bagaev record-form/5;
program {
// Pure inventory data; no external stock mutation.
  record Item { sku: Text, available: Int64 };
  list Stock of Item capacity 16;
  record Receipt { stock: Stock, sku: Text, amount: Int64 };
  variant Outcome { Rejected: Text, Reserved: Receipt };
  list Receipts of Receipt capacity 4;
  record BatchReceipt { stock: Stock, receipts: Receipts };
  record BatchError { step: Int64, reason: Text, stock: Stock };
  variant BatchOutcome { BatchCommitted: BatchReceipt, BatchRejected: BatchError };
  entry batch_main;
  fn sku_ok(sku: Text) -> Bool =
    if 0 < text.bytes(sku) then int.le(text.bytes(sku), 32) else false;
  fn unique_at(stock: Stock, index: Int64) -> Bool =
    fold (16, true) with (j, ok) in
      if ok then
        if j < records.len(stock) then
          if int.eq(j, index) then true
          else bool.not(text.eq(record.field(records.at(stock, index), "sku"), record.field(records.at(stock, j), "sku")))
        else true
      else false;
  fn stock_ok(stock: Stock) -> Bool =
    fold (16, true) with (i, ok) in
      if ok then
        if i < records.len(stock) then
          let item = records.at(stock, i) in
          if item.available < 0 then false
          else if sku_ok(item.sku) then unique_at(stock, i) else false
        else true
      else false;
  fn find(stock: Stock, sku: Text) -> Int64 =
    fold (16, -1) with (i, found) in
      if i < records.len(stock) then
        if text.eq(record.field(records.at(stock, i), "sku"), sku) then i else found
      else found;
  fn decrement(stock: Stock, index: Int64, amount: Int64) -> Stock =
    fold (16, records.list(Stock)) with (i, result) in
      if i < records.len(stock) then
        let item = records.at(stock, i) in
        records.push(result, if int.eq(i, index)
          then Item { sku: item.sku, available: item.available - amount }
          else item)
      else result;
  fn reserve(stock: Stock, sku: Text, amount: Int64) -> Outcome =
    if amount < 1 then Outcome.Rejected("invalid-request")
    else if bool.not(sku_ok(sku)) then Outcome.Rejected("invalid-request")
    else if 5 < amount then Outcome.Rejected("order-limit")
    else if bool.not(stock_ok(stock)) then Outcome.Rejected("invalid-stock")
    else let index = find(stock, sku) in
      if index < 0 then Outcome.Rejected("not-found")
      else if record.field(records.at(stock, index), "available") < amount
        then Outcome.Rejected("insufficient-stock")
      else Outcome.Reserved(Receipt { stock: decrement(stock, index, amount), sku: sku, amount: amount });

  fn item_shape(x: Json) -> Bool =
    if text.eq(json.kind(x), "object") then
      if int.eq(option.or(json.len(x), -1), 2) then
        if json.is_text(json.field(x, "sku")) then
          option.is_some(json.int(json.field(x, "available")))
        else false
      else false
    else false;
  fn stock_shape(x: Json) -> Bool =
    if text.eq(json.kind(x), "array") then
      let size = option.or(json.len(x), -1) in
      if int.le(size, 16) then
        fold (16, true) with (i, ok) in
          if ok then
            if i < size then item_shape(json.at(x, i)) else true
          else false
      else false
    else false;
  fn request_shape(x: Json) -> Bool =
    if text.eq(json.kind(x), "object") then
      if int.eq(option.or(json.len(x), -1), 4) then
        if text.eq(json.text_or(json.field(x, "interface"), ""), "inventory-reserve/1") then
          if stock_shape(json.field(x, "stock")) then
            if json.is_text(json.field(x, "sku")) then
              option.is_some(json.int(json.field(x, "amount")))
            else false
          else false
        else false
      else false
    else false;
  fn read_stock(x: Json) -> Stock =
    fold (16, records.list(Stock)) with (i, stock) in
      if i < option.or(json.len(x), 0) then
        let item = json.at(x, i) in
        records.push(stock, Item {
          sku: json.text_or(json.field(item, "sku"), ""),
          available: option.or(json.int(json.field(item, "available")), 0)
        })
      else stock;
  fn main(x: Json) -> Outcome =
    if request_shape(x) then
      reserve(read_stock(json.field(x, "stock")),
        json.text_or(json.field(x, "sku"), ""),
        option.or(json.int(json.field(x, "amount")), 0))
    else Outcome.Rejected("request-shape");

  fn reserve_valid_stock(stock: Stock, sku: Text, amount: Int64) -> Outcome =
    if amount < 1 then Outcome.Rejected("invalid-request")
    else if bool.not(sku_ok(sku)) then Outcome.Rejected("invalid-request")
    else if 5 < amount then Outcome.Rejected("order-limit")
    else let index = find(stock, sku) in
      if index < 0 then Outcome.Rejected("not-found")
      else if record.field(records.at(stock, index), "available") < amount
        then Outcome.Rejected("insufficient-stock")
      else Outcome.Reserved(Receipt { stock: decrement(stock, index, amount), sku: sku, amount: amount });

  fn order_shape(x: Json) -> Bool =
    if text.eq(json.kind(x), "object") then
      if int.eq(option.or(json.len(x), -1), 2) then
        if json.is_text(json.field(x, "sku")) then option.is_some(json.int(json.field(x, "amount")))
        else false
      else false
    else false;
  fn orders_shape(x: Json) -> Bool =
    if text.eq(json.kind(x), "array") then
      let size = option.or(json.len(x), -1) in
      if int.le(size, 4) then
        fold (4, true) with (i, ok) in
          if ok then if i < size then order_shape(json.at(x, i)) else true else false
      else false
    else false;
  fn batch_shape(x: Json) -> Bool =
    if text.eq(json.kind(x), "object") then
      if int.eq(option.or(json.len(x), -1), 3) then
        if text.eq(json.text_or(json.field(x, "interface"), ""), "inventory-batch/1") then
          if stock_shape(json.field(x, "stock")) then orders_shape(json.field(x, "requests")) else false
        else false
      else false
    else false;
  fn batch_apply(original: Stock, orders: Json) -> BatchOutcome =
    // Only this function body is replaced in this walkthrough.
    let size = option.or(json.len(orders), 0) in
    // Original body note; replacement may remove it.
    if int.eq(size, 0) then
      if stock_ok(original) then BatchOutcome.BatchCommitted(BatchReceipt { stock: original, receipts: records.list(Receipts) })
      else BatchOutcome.BatchRejected(BatchError { step: -1, reason: "invalid-stock", stock: original })
    else fold (4, BatchOutcome.BatchCommitted(BatchReceipt { stock: original, receipts: records.list(Receipts) })) with (i, state) in
      match (state) {
        BatchRejected(error): BatchOutcome.BatchRejected(error);
        BatchCommitted(done):
          if i < size then
            let order = json.at(orders, i) in
            match (if int.eq(i, 0) then reserve(done.stock, json.text_or(json.field(order, "sku"), ""), option.or(json.int(json.field(order, "amount")), 0)) else reserve_valid_stock(done.stock, json.text_or(json.field(order, "sku"), ""), option.or(json.int(json.field(order, "amount")), 0))) {
              Rejected(reason): BatchOutcome.BatchRejected(BatchError { step: i, reason: reason, stock: original });
              Reserved(receipt): BatchOutcome.BatchCommitted(BatchReceipt { stock: receipt.stock, receipts: records.push(done.receipts, receipt) });
            }
          else BatchOutcome.BatchCommitted(done);
      };
  fn batch_main(x: Json) -> BatchOutcome =
    if batch_shape(x) then batch_apply(read_stock(json.field(x, "stock")), json.field(x, "requests"))
    else BatchOutcome.BatchRejected(BatchError { step: -1, reason: "request-shape", stock: records.list(Stock) });
}
