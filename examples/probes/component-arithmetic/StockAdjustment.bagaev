bagaev component-form/3;
component StockItem operation adjust_quantity {
  record StockKey { code: Text };
  record StockVersion { value: Int64 };
  record Stock { key: StockKey, quantity: Int64, note: Text };
  record AdjustStock { item: StockKey, expected: StockVersion, delta: Int64 };
  record StockError { reason: Text };
  variant StockOutcome { Decline: StockError, Propose: Stock };
  state Stock identity key;
  request AdjustStock identity item revision expected: StockVersion;
  replace quantity;
  outcome StockOutcome error StockError;
  entry apply;
  fn apply(state: Stock, request: AdjustStock) -> StockOutcome =
    let next = state.quantity + request.delta in
    if next < 0
    then StockOutcome.Decline(StockError { reason: "negative-quantity" })
    else StockOutcome.Propose(Stock { key: state.key, note: state.note, quantity: next });
}
