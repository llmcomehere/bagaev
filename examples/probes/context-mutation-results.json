  "recipes": [
    {
      "id": "CM-AXIS",
      "module": "bagaev_probe_context",
      "old": "_need(value[key]==name,'CTX_VERSION',path+'/'+key)",
      "new": "pass # deliberately ignore mandatory axis version",
      "replacements": 1
    },
    {
      "id": "CM-LATEST",
      "module": "bagaev_probe_context",
      "old": "_need(expected['snapshot']==snapshot and context['snapshot']==snapshot,'CTX_STALE','/snapshot')",
      "new": "pass # deliberately omit snapshot binding",
      "replacements": 1
    },
    {
      "id": "CM-FETCH",
      "module": "bagaev_probe_context",
      "old": "for row in expected['sources']:",
      "new": "for row in [r for r in expected['sources'] if r['id'] in sources]:",
      "replacements": 1
    },
    {
      "id": "CM-SUMMARY",
      "module": "bagaev_probe_context",
      "old": "for row in expected['obligations']:",
      "new": "for row in [r for r in expected['obligations'] if r['id'] in obligations]:",
      "replacements": 1
    },
    {
      "id": "CM-MAP",
      "module": "bagaev_probe_context",
      "old": "_need(expected['candidate_set']==context['candidate_set'],'CTX_REMAPPED','/candidate_set')",
      "new": "pass # deliberately trust packet mapping",
      "replacements": 1
    },
    {
      "id": "CM-EVIDENCE",
      "module": "bagaev_probe_context",
      "old": "_need(value['context']==_hash(context),'CTX_STALE','/context')",
      "new": "pass # deliberately ignore evidence context binding",
      "replacements": 1
    },
    {
      "id": "CM-ABSENT",
      "module": "bagaev_probe_context",
      "old": "if source is None:return {'phase':'evidence','status':'absent','records':[]}",
      "new": "if source is None:return {'phase':'evidence','status':'supported','records':[]}",
      "replacements": 1
    },
    {
      "id": "CM-AUTOMODEL",
      "module": "bagaev_probe_context",
      "old": "_need(value['role'] not in ('rank','solve'),'CTX_UNSUPPORTED','/role')",
      "new": "pass # deliberately treat unsupported role as supported; no real model call",
      "replacements": 1
    },
    {
      "id": "CM-DRAFT-ADMIT",
      "module": "bagaev_probe_context",
      "old": "event.update({'content':copy.deepcopy(value['content']),'content_pin':value['content_pin']})",
      "new": "event.update({'content':copy.deepcopy(value['content']),'content_pin':value['content_pin'],'admission':True})",
      "replacements": 1
    },
    {
      "id": "CM-DRAFT-CHOICE",
