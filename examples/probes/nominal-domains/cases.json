      "id": "EQUAL",
      "program": {
        "schema": "bagaev-typed-record/8",
        "records": {
          "ArtifactDigest": {
            "value": "Text"
          },
          "RequestDigest": {
            "value": "Text"
          }
        },
        "lists": {},
        "variants": {},
        "entry": "main",
        "functions": {
          "same": {
            "params": [
              [
                "a",
                "ArtifactDigest"
              ],
              [
                "b",
                "ArtifactDigest"
              ]
            ],
            "result": "Bool",
            "body": [
              "text.eq",
              [
                "field",
                [
                  "arg",
                  "a"
                ],
                "value"
              ],
              [
                "field",
                [
                  "arg",
                  "b"
                ],
                "value"
              ]
            ]
          },
          "main": {
            "params": [],
            "result": "Bool",
            "body": [
              "call",
              "same",
              [
                "record",
                "ArtifactDigest",
                [
                  "text",
                  "x"
                ]
              ],
              [
                "record",
                "ArtifactDigest",
                [
                  "text",
                  "x"
                ]
              ]
            ]
          }
        }
      },
      "rust_source": "#[allow(dead_code)] struct ArtifactDigest(&'static str);\n#[allow(dead_code)] struct RequestDigest(&'static str);\n#[allow(dead_code)] fn same(a:ArtifactDigest,b:ArtifactDigest)->bool{a.0==b.0}\nfn main(){assert!(same(ArtifactDigest(\"x\"),ArtifactDigest(\"x\")));}",
      "expected": {
        "status": "success",
        "value": true
      },
      "reference_hex": "7b226c6f636174696f6e223a6e756c6c2c22726561736f6e223a6e756c6c2c22736368656d61223a226261676165762d74797065642d7265636f72642d726573756c742f38222c22737461747573223a2273756363657373222c2276616c7565223a747275652c2276616c75655f74797065223a22426f6f6c222c22776f726b223a31347d0a",
