    {
      "id": "KM-WRAP",
      "source": "llvm.rs",
      "old": "writeln!(self.output,\"  br i1 {overflow}, label %{refuse}, label %{normal}\")?;",
      "new": "let overflow=if matches!(op,BinaryOp::Add) { \"false\".to_owned() } else {overflow}; writeln!(self.output,\"  br i1 {overflow}, label %{refuse}, label %{normal}\")?;"
    },
    {
      "id": "KM-SUB",
      "source": "llvm.rs",
      "old": "writeln!(self.output,\"  br i1 {overflow}, label %{refuse}, label %{normal}\")?;",
      "new": "let overflow=if matches!(op,BinaryOp::Sub) { \"false\".to_owned() } else {overflow}; writeln!(self.output,\"  br i1 {overflow}, label %{refuse}, label %{normal}\")?;"
    },
    {
      "id": "KM-MUL",
      "source": "llvm.rs",
      "old": "writeln!(self.output,\"  br i1 {overflow}, label %{refuse}, label %{normal}\")?;",
      "new": "let overflow=if matches!(op,BinaryOp::Mul) { \"false\".to_owned() } else {overflow}; writeln!(self.output,\"  br i1 {overflow}, label %{refuse}, label %{normal}\")?;"
    },
    {
      "id": "KM-EAGER",
      "source": "llvm.rs",
      "old": "let value=self.expression(condition)?;",
      "new": "let value=self.expression(condition)?; let _=self.expression(yes)?; let _=self.expression(no)?;"
    },
    {
      "id": "KM-ZERO",
      "source": "llvm.rs",
      "old": "let more=self.value(&format!(\"icmp ult i64 {index}, {count}\"))?;",
      "new": "let count=if count==0 {1}else{count}; let more=self.value(&format!(\"icmp ult i64 {index}, {count}\"))?;"
    },
    {
      "id": "KM-TICKS",
      "source": "llvm.rs",
      "old": "writeln!(self.output,\"  ; node {id}\")?; self.tick(id)?;",
      "new": "writeln!(self.output,\"  ; node {id}\")?; if id==self.program.functions()[self.function].body() {self.tick(id)?;}"
    },
    {
      "id": "KM-OFFBYONE",
      "source": "llvm.rs",
      "old": "icmp uge i64 {work}, 65536",
      "new": "icmp uge i64 {work}, 65535"
    },
    {
