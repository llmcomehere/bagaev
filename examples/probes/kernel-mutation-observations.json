    {
      "id": "KM-BOOLCOERCE",
      "source": "check.rs",
      "old": "Value::Integer(token)=>token.parse().map_err(|_|Refusal::new(Reason::Bounds,path)),",
      "new": "Value::Bool(value)=>Ok(if *value {1}else{0}), Value::Integer(token)=>token.parse().map_err(|_|Refusal::new(Reason::Bounds,path)),"
