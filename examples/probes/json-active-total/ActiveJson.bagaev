bagaev record-form/6;
program {
  record Outcome { valid: Bool, total: Int64 };
  entry main;
  fn item_shape(x: Json) -> Bool =
    if text.eq(json.kind(x), "object") then
      if int.eq(option.or(json.len(x), -1), 2) then
        if option.is_some(json.int(json.field(x, "amount"))) then
          text.eq(json.kind(json.field(x, "active")), "bool")
        else false
      else false
    else false;
  fn input_shape(x: Json) -> Bool =
    if text.eq(json.kind(x), "array") then
      if int.le(option.or(json.len(x), -1), 16) then
        fold (16, true) with (i, ok) in
          if ok then
            if i < option.or(json.len(x), 0) then item_shape(json.at(x, i))
            else true
          else false
      else false
    else false;
  fn active_sum(x: Json) -> Int64 =
    fold (16, 0) with (i, sum) in
      if i < option.or(json.len(x), 0) then
        let item = json.at(x, i) in
        if json.bool_or(json.field(item, "active"), false) then
          sum + option.or(json.int(json.field(item, "amount")), 0)
        else sum
      else sum;
  fn main(x: Json) -> Outcome =
    if input_shape(x) then Outcome { valid: true, total: active_sum(x) }
    else Outcome { valid: false, total: 0 };
}
