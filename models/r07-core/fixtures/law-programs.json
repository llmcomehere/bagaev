  "manual_cases": [
    {
      "id": "L01_count_permutation",
      "program_ref": "r02:size_ordered",
      "before": {
        "members": [
          "a",
          "b"
        ]
      },
      "after": {
        "members": [
          "b",
          "a"
        ]
      },
      "expected_before": {
        "status": "ok",
        "value": 2,
        "error": null,
        "trace": [],
        "complete": true
      },
      "expected_after": {
        "status": "ok",
        "value": 2,
        "error": null,
        "trace": [],
        "complete": true
      },
      "expected_r02_decision": "RECHECK",
      "expected_refined_decision": "EXCLUDED",
      "purpose": "Exact size/order law removes only order sensitivity."
    },
    {
      "id": "L02_set_permutation",
