/// Тесты исходной программы: форма авторства, полнота атрибуции у потребителей, масштабирование.
@id("qdd4h6")
module blog.tests

use std.test
use blog.people.{Person}
use blog.people
use blog.actors
use blog.articles.{Article}
use blog.articles
use blog.authorship
use blog.authorship.{AuthorError, AuthorshipShape, AttributionComplete}
use blog.byline
use blog.export
use blog.image.{Image}
use blog.image

@id("ay3gdq")
fn alina() -> Person {
  Person { id: people.person_id("p_alina"), display_name: "Алина Петрова", email: "alina@blog.test" }
}

@id("t2qcj7")
fn sample() -> Article {
  Article {
    id: articles.article_id("a_101"),
    title: "Типы и связи",
    author: people.person_id("p_alina"),
    editors: [actors.actor_id("u_editor")],
    revision: 1,
  }
}

@id("d8b83m")
test single_author_accepted
  checks AuthorshipShape.single, AuthorshipShape.existing
{
  test.expect_equal("один автор", authorship.check_author([people.person_id("p_alina")], Map { people.person_id("p_alina") => alina() }), Ok(people.person_id("p_alina")))
}

@id("jz6a4r")
test two_authors_rejected
  checks AuthorshipShape.single
{
  test.expect_equal("два автора", authorship.check_author([people.person_id("p_alina"), people.person_id("p_alina")], Map { people.person_id("p_alina") => alina() }), Err(AuthorError.NotExactlyOne))
}

@id("rcj566")
test unknown_author_rejected
  checks AuthorshipShape.existing
{
  test.expect_equal("неизвестный", authorship.check_author([people.person_id("p_missing")], Map { people.person_id("p_alina") => alina() }), Err(AuthorError.UnknownPerson(people.person_id("p_missing"))))
}

@id("zzcmgt")
test byline_names_author
  checks AttributionComplete.complete
{
  test.expect_equal("подпись", byline.byline(sample(), Map { people.person_id("p_alina") => alina() }), "Алина Петрова")
}

@id("yr6x7v")
test export_keeps_author
  checks AttributionComplete.complete
{
  test.expect_equal("экспорт", export.export_article(sample(), Map { people.person_id("p_alina") => alina() }), "{\"article_id\":\"a_101\",\"author\":{\"display_name\":\"Алина Петрова\",\"person_id\":\"p_alina\"},\"title\":\"Типы и связи\"}")
}

@id("fnp5b7")
test resize_nearest {
  let img = Image { width: 2, height: 2, pixels: [[255, 0, 0, 255], [0, 255, 0, 255], [0, 0, 255, 255], [255, 255, 255, 255]] };
  test.expect_equal("1×1", image.resize(img, 1, 1).pixels, [[255, 0, 0, 255]])
}
