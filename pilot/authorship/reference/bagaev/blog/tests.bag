/// Тесты программы: форма списка авторов, полнота атрибуции у потребителей, масштабирование.
@id("qdd4h6")
module blog.tests

use std.test
use blog.people.{PersonId, Person}
use blog.people
use blog.actors
use blog.articles.{Article}
use blog.articles
use blog.authorship
use blog.authorship.{AuthorError, AuthorshipShape, AttributionComplete}
use blog.byline
use blog.export
use blog.image.{Image}
use blog.image

@id("ay3gdq")
fn everyone() -> Map<PersonId, Person> {
  Map {
    people.person_id("p_alina") => Person { id: people.person_id("p_alina"), display_name: "Алина Петрова", email: "alina@blog.test" },
    people.person_id("p_boris") => Person { id: people.person_id("p_boris"), display_name: "Борис Соколов", email: "boris@blog.test" },
  }
}

@id("t2qcj7")
fn sample() -> Article {
  Article {
    id: articles.article_id("a_101"),
    title: "Типы и связи",
    authors: [people.person_id("p_boris"), people.person_id("p_alina")],
    editors: [actors.actor_id("u_editor")],
    revision: 2,
  }
}

@id("d8b83m")
test authors_accepted_in_order
  checks AuthorshipShape.nonempty, AuthorshipShape.existing, AuthorshipShape.unique, AuthorshipShape.ordered
{
  let ids = [people.person_id("p_boris"), people.person_id("p_alina")];
  let r: Result<Seq<PersonId>, AuthorError> = Ok(ids);
  test.expect_equal("два автора по порядку", authorship.check_authors(ids, everyone()), r)
}

@id("ryegef")
test empty_rejected
  checks AuthorshipShape.nonempty
{
  let none: Seq<PersonId> = [];
  let r: Result<Seq<PersonId>, AuthorError> = Err(AuthorError.Empty);
  test.expect_equal("пустой список", authorship.check_authors(none, everyone()), r)
}

@id("c1apr9")
test duplicate_rejected
  checks AuthorshipShape.unique
{
  let r: Result<Seq<PersonId>, AuthorError> = Err(AuthorError.Duplicate(people.person_id("p_alina")));
  test.expect_equal("повтор", authorship.check_authors([people.person_id("p_alina"), people.person_id("p_alina")], everyone()), r)
}

@id("rcj566")
test unknown_author_rejected
  checks AuthorshipShape.existing
{
  let r: Result<Seq<PersonId>, AuthorError> = Err(AuthorError.UnknownPerson(people.person_id("p_missing")));
  test.expect_equal("неизвестный", authorship.check_authors([people.person_id("p_missing")], everyone()), r)
}

@id("zzcmgt")
test byline_lists_all_authors
  checks AttributionComplete.complete
{
  test.expect_equal("подпись", byline.byline(sample(), everyone()), "Борис Соколов · Алина Петрова")
}

@id("yr6x7v")
test export_keeps_all_authors
  checks AttributionComplete.complete
{
  test.expect_equal("экспорт", export.export_article(sample(), everyone()), "{\"article_id\":\"a_101\",\"authors\":[{\"display_name\":\"Борис Соколов\",\"person_id\":\"p_boris\"},{\"display_name\":\"Алина Петрова\",\"person_id\":\"p_alina\"}],\"title\":\"Типы и связи\"}")
}

@id("fnp5b7")
test resize_nearest {
  let img = Image { width: 2, height: 2, pixels: [[255, 0, 0, 255], [0, 255, 0, 255], [0, 0, 255, 255], [255, 255, 255, 255]] };
  test.expect_equal("1×1", image.resize(img, 1, 1).pixels, [[255, 0, 0, 255]])
}
