/// Статьи. Редакторы статьи — отдельный список: право правки не следует из авторства.
@id("7a8vva")
module blog.articles

use blog.people.{PersonId}
use blog.actors.{ActorId}

@id("ahzmpd")
pub type ArticleId = opaque String

/// Схема до перехода: ровно один автор (строение прежней Article — для миграции).
@id("ghx34w")
pub type ArticleV1 = record {
  @id("0mszwx") id: ArticleId,
  @id("g8zdm6") title: String,
  @id("nynqpq") author: PersonId,
  @id("620chf") editors: Seq<ActorId>,
  @id("7e7dbz") revision: Int64,
}

@id("gcy5ez")
pub type Article = record {
  @id("1hdvey") id: ArticleId,
  @id("r65yf1") title: String,
  @id("9kpw0w") authors: Seq<PersonId>,
  @id("xn6gsr") editors: Seq<ActorId>,
  @id("p6922j") revision: Int64,
}

@id("p2y73s")
pub fn article_id(raw: String) -> ArticleId {
  ArticleId(raw)
}

@id("mpyahx")
pub fn id_text(a: ArticleId) -> String {
  match a {
    ArticleId(s) => s,
  }
}
