  @id("gxs6s7") title: String,
}

@id("twnn8r")
store Blog {
  @id("r4f214") table articles: Map<Int64, Article>
}

@id("a32w5e")
event Renamed {
  @id("9wm10c") id: Int64,
  @id("y7fg34") title: String,
}

@id("dsw81f")
