{
  "id": "edit/overlap-01",
  "spec": [
    "spec/protocol/agent-protocol.md#3-sourceedit-и-идентичность"
  ],
  "origin": "independent",
  "levels": [
    "L2"
  ],
  "files": [
    "app.bag"
  ],
  "run": {
    "change": {
      "principal": "agent",
      "steps": [
        {
          "request": {
            "operation": "change_begin",
            "idempotency_key": "b1-kkkkkkkkkkkkkkkkkkkk",
            "arguments": {
              "intent": "изменение"
            }
          }
        },
        {
          "request": {
            "operation": "apply",
            "change_id": "$change",
            "expected_work_revision": 1,
            "idempotency_key": "a1-kkkkkkkkkkkkkkkkkkkk",
            "arguments": {
              "source_edit": {
                "files": [
                  {
                    "path": "app.bag",
                    "base_sha256": "$sha:app.bag",
                    "edits": [
                      {
                        "start": 560,
                        "end": 565,
                        "text": "n"
                      },
                      {
                        "start": 562,
                        "end": 565,
                        "text": "+ 2"
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "request": {
            "operation": "apply",
            "change_id": "$change",
            "expected_work_revision": 1,
            "idempotency_key": "a2-kkkkkkkkkkkkkkkkkkkk",
            "arguments": {
              "source_edit": {
                "files": [
                  {
                    "path": "app.bag",
                    "base_sha256": "$sha:app.bag",
                    "edits": [
                      {
                        "start": 560,
                        "end": 560,
                        "text": "("
                      },
                      {
                        "start": 560,
                        "end": 560,
                        "text": "["
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "phase": "edit",
    "outcome": "COMPLETED",
    "value": [
      {
        "status": "succeeded",
        "replayed": false,
        "work_revision": 1
      },
      {
        "status": "blocked",
        "replayed": false,
        "code": "OVERLAPPING_EDITS",
        "data": {
          "path": "app.bag",
          "edits": [
            0,
            1
          ]
        }
      },
      {
        "status": "blocked",
        "replayed": false,
        "code": "OVERLAPPING_EDITS",
        "data": {
          "path": "app.bag",
          "edits": [
            0,
            1
          ]
        }
      }
    ]
  },
  "note": "пересечение и две вставки в одну точку — порядок неоднозначен"
}
