{
  "id": "edit/old-text-overlap-01",
  "spec": [
    "spec/protocol/agent-protocol.md#3-sourceedit-и-идентичность"
  ],
  "origin": "independent",
  "levels": [
    "L2"
  ],
  "files": [
    "app.bag"
  ],
  "run": {
    "change": {
      "principal": "agent",
      "steps": [
        {
          "request": {
            "operation": "change_begin",
            "idempotency_key": "b1-kkkkkkkkkkkkkkkkkkkk",
            "arguments": {
              "intent": "изменение"
            }
          }
        },
        {
          "request": {
            "operation": "apply",
            "change_id": "$change",
            "expected_work_revision": 1,
            "idempotency_key": "a1-kkkkkkkkkkkkkkkkkkkk",
            "arguments": {
              "source_edit": {
                "files": [
                  {
                    "path": "app.bag",
                    "base_sha256": "$sha:app.bag",
                    "edits": [
                      {
                        "old_text": "аа",
                        "text": "б"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "phase": "edit",
    "outcome": "COMPLETED",
    "value": [
      {
        "status": "succeeded",
        "replayed": false,
        "work_revision": 1
      },
      {
        "status": "blocked",
        "replayed": false,
        "code": "AMBIGUOUS_EDIT",
        "data": {
          "path": "app.bag",
          "edit": 0,
          "occurrences": 2
        }
      }
    ]
  },
  "note": "перекрывающиеся вхождения тоже считаются: «аа» в «ааа» — два (ревью m6 M2)"
}
