/// Проверки обязательства «экспорт сохраняет весь состав и порядок».
@id("5heyrj")
module blog.tests

use std.test
use std.map
use std.option
use std.store
use std.result
use blog.db.{Blog}
use blog.people
use blog.people.{PersonId, Person}
use blog.articles
use blog.articles.{Article}
use blog.authorship
use blog.authorship.{AttributionComplete, AuthorsShape}
use blog.export

@id("c7sav3")
fn fixture_people() -> Map<PersonId, Person> {
  Map {
    people.person_id("p_alina") => Person { id: people.person_id("p_alina"), display_name: "Алина Петрова" },
    people.person_id("p_boris") => Person { id: people.person_id("p_boris"), display_name: "Борис Соколов" },
  }
}

@id("8hqzc5")
test export_keeps_all_authors
  checks AttributionComplete.complete
{
  let ids = [people.person_id("p_boris"), people.person_id("p_alina")];
  match authorship.make(ids, fixture_people()) {
    Ok(list) => {
      let a = Article { id: articles.article_id("a_101"), title: "Типы и связи", authors: list, revision: 2 };
      test.expect_equal(
        "оба автора в порядке редактора",
        export.export_article(a, fixture_people()),
        "{\"article_id\":\"a_101\",\"authors\":[{\"display_name\":\"Борис Соколов\",\"person_id\":\"p_boris\"},{\"display_name\":\"Алина Петрова\",\"person_id\":\"p_alina\"}],\"title\":\"Типы и связи\"}",
      )
    },
    Err(_) => test.expect("авторы допустимы", false),
  }
}

/// Тест с эффектами исполняется на отдельной пустой копии хранилища (HST-18).
@id("h4st0a")
test store_copy_is_isolated
  uses { reads Blog.articles, writes Blog.articles }
{
  let id = articles.article_id("a_7");
  test.expect("копия хранилища пуста", option.is_some(store.get(Blog.articles, id)) == false);
  match authorship.make([people.person_id("p_alina")], fixture_people()) {
    Ok(list) => {
      store.put(Blog.articles, id, Article { id: id, title: "Копия", authors: list, revision: 1 });
      test.expect_equal("запись видна в той же транзакции", store.contains(Blog.articles, id), true)
    },
    Err(_) => test.expect("авторы допустимы", false),
  }
}

/// Форма списка авторов: правила, на которые полагается редактор (основание D83(a) для его вызова make).
@id("shp001")
test make_enforces_shape
  checks AuthorsShape.nonempty, AuthorsShape.unique
{
  let p = people.person_id("p_alina");
  test.expect("пустой список отвергается", result.is_ok(authorship.make([], fixture_people())) == false);
  test.expect("повтор отвергается", result.is_ok(authorship.make([p, p], fixture_people())) == false);
}
