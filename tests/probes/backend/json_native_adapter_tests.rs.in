use json_native_adapter_v8::{evaluate,NativeValue,NativeText,KernelOutput,Cells,Arena,Error};use composite_export_v8::Output;use std::sync::atomic::{AtomicUsize,Ordering};static CALLS:AtomicUsize=AtomicUsize::new(0);static MODE:AtomicUsize=AtomicUsize::new(0);const ZERO:NativeValue=NativeValue{scalar:0,bytes:std::ptr::null(),len:0,scalars:0};
unsafe extern "C" fn marker(_: *const NativeValue,_:*mut Arena,cells:*mut Cells,out:*mut KernelOutput){CALLS.fetch_add(1,Ordering::SeqCst);let mode=MODE.load(Ordering::SeqCst);let mut o=KernelOutput{meta:Output{status:0,value_type:2,value:1,work:2,reason:0,location:0},value:ZERO};if mode==1{o.meta.work=65537;}if mode==2{unsafe{(*cells).capacity=1;}}if mode==3{o.meta.value=2;}unsafe{out.write(o);}}
