fn bounded_read(path:&str)->Vec<u8>{use std::io::Read;let f=std::fs::File::open(path).unwrap();let meta=f.metadata().unwrap();assert!(meta.is_file()&&meta.len()<=1048576);let mut raw=Vec::new();f.take(1048577).read_to_end(&mut raw).unwrap();assert!(raw.len()<=1048576);raw}
fn main(){let args:Vec<_>=std::env::args().collect();assert_eq!(args.len(),2);let raw=bounded_read(&args[1]);let out=typed_record::process_v8(&raw).unwrap();use std::io::Write;std::io::stdout().write_all(&out).unwrap();}
