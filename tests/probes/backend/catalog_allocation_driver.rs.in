#[path="{{ALLOCATION_DIR}}/counter.rs"]mod counter;
#[global_allocator]static ALLOCATOR:counter::Tracked=counter::Tracked;
use counter::Snapshot;
enum Runner{Normal(call_boundary::Session),Profiled(instrumented_boundary::Session)}
impl Runner{
 fn new(kind:&str,mode:&str,source:&[u8])->Self{match kind{"normal"=>Self::Normal(call_boundary::Session::new(mode,source).unwrap()),"profiled"=>Self::Profiled(instrumented_boundary::Session::new(mode,source).unwrap()),_=>panic!("kind")}}
 unsafe fn call(&mut self,raw:&[u8],marks:&mut[Snapshot;4])->Result<Vec<u8>,String>{match self{
  Self::Normal(s)=>{marks[0]=counter::snapshot();counter::reset_peak();let out=unsafe{s.call(raw)};marks[3]=counter::snapshot();marks[1]=marks[3];marks[2]=marks[3];out},
  Self::Profiled(s)=>unsafe{s.call(raw,marks)},
 }}
}
fn read(path:&str)->Vec<u8>{use std::io::Read;let f=std::fs::File::open(path).unwrap();let m=f.metadata().unwrap();assert!(m.is_file()&&m.len()<=1048576);let mut b=Vec::new();f.take(1048577).read_to_end(&mut b).unwrap();assert!(b.len()<=1048576);b}
fn snap(s:Snapshot){print!("{{\"live\":{},\"peak\":{},\"alloc\":{},\"realloc\":{},\"dealloc\":{}}}",s.live,s.peak,s.alloc,s.realloc,s.dealloc);}
fn main(){
 let a:Vec<_>=std::env::args().collect();assert_eq!(a.len(),6);let count=match a[3].as_str(){"qualify"=>1,"collect"=>16,_=>panic!("phase")};
 let raw=read(&a[4]);let expected=read(&a[5]);let before=raw.clone();assert!(counter::failed_resize_probe());let base=counter::snapshot();counter::reset_peak();let mut runner=Runner::new(&a[2],&a[1],include_bytes!("{{SOURCE}}"));let prepared=counter::snapshot();
 let mut rows=[([base;4],base,0usize,0usize);16];
 for row in rows.iter_mut().take(count){
  let mut marks=[counter::snapshot();4];let out=unsafe{runner.call(std::hint::black_box(&raw),&mut marks)}.unwrap();let len=out.len();let capacity=out.capacity();assert_eq!(std::hint::black_box(out.as_slice()),expected.as_slice());assert_eq!(raw,before);assert_eq!(marks[3].live-marks[0].live,capacity as u64);drop(out);let after=counter::snapshot();assert_eq!(after.live,marks[0].live);*row=(marks,after,len,capacity);
 }
 drop(runner);let final_state=counter::snapshot();assert_eq!(final_state.live,base.live);
 print!("{{\"kind\":\"{}\",\"mode\":\"{}\",\"base\":",a[2],a[1]);snap(base);print!(",\"prepared\":");snap(prepared);print!(",\"final\":");snap(final_state);print!(",\"rows\":[");
 for(i,(marks,after,len,cap))in rows.iter().take(count).enumerate(){if i>0{print!(",");}print!("{{\"call\":{i},\"marks\":[");for(j,m)in marks.iter().enumerate(){if j>0{print!(",");}snap(*m);}print!("],\"after\":");snap(*after);print!(",\"output_len\":{len},\"output_capacity\":{cap}}}");}println!("]}}");
}
