fn bounded_read(path:&str,limit:usize)->Vec<u8>{
 use std::io::Read;
 let file=std::fs::File::open(path).unwrap();let meta=file.metadata().unwrap();
 assert!(meta.is_file()&&meta.len()<=limit as u64);
 let mut bytes=Vec::new();file.take(limit as u64+1).read_to_end(&mut bytes).unwrap();
 assert!(bytes.len()<=limit);bytes
}

fn main(){let a:Vec<_>=std::env::args().collect();assert_eq!(a.len(),4);assert!(a[3]=="run"||a[3]=="admit");let source=bounded_read(&a[1],1048576);let raw=bounded_read(&a[2],1048576);let p=typed_record::prepare_json_program_v8(&source).unwrap();match typed_record::prepare_json_arguments_v8(&p,&raw){Ok(i)=>{if a[3]=="admit"{println!("true");}else{let out=typed_record::evaluate_prepared_json_v8(&i).unwrap();use std::io::Write;std::io::stdout().write_all(&out).unwrap();}},Err(_)=>{assert_eq!(a[3],"admit");println!("false");}}}
