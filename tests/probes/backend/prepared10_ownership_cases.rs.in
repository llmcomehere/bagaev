pub const SOURCE:&[u8]=br#"{"schema":"bagaev-typed-record/10","records":{},"lists":{},"variants":{},"entry":"main","functions":{"main":{"params":[["x","Json"]],"result":"Bool","body":["json.is_text",["arg","x"]]}}}"#;
pub unsafe extern "C" fn marker(_: *const prepared_json_native_v10::NativeValue,_: *mut prepared_json_native_v10::Arena,_: *mut prepared_json_native_v10::Cells,_: *mut prepared_json_native_v10::KernelOutput){}
#[cfg(return_local)]
pub fn attempt()->typed_record::PreparedJsonInvocationV10<'static>{let p=typed_record::prepare_json_program_v10(SOURCE).unwrap();typed_record::prepare_json_arguments_v10(&p,b"[null]").unwrap()}

#[cfg(drop_borrowed)]
pub fn attempt(){let p=typed_record::prepare_json_program_v10(SOURCE).unwrap();let i=typed_record::prepare_json_arguments_v10(&p,b"[null]").unwrap();drop(p);let _=typed_record::evaluate_prepared_json_v10(&i);}
#[cfg(private_field)]
pub fn attempt(p:typed_record::PreparedJsonProgramV10){let _=&p.source;}

#[cfg(scoped_borrow)]
pub fn attempt(){let p=typed_record::prepare_json_program_v10(SOURCE).unwrap();let i=typed_record::prepare_json_arguments_v10(&p,b"[null]").unwrap();let result=typed_record::evaluate_prepared_json_v10(&i).unwrap();drop(i);drop(p);assert!(!result.is_empty());}
#[cfg(unsafe_required)]
pub fn attempt(p:&prepared_json_native_v10::Prepared,t:&mut[prepared_json_native_v10::NativeText],c:&mut[prepared_json_native_v10::NativeValue]){let _=prepared_json_native_v10::evaluate(p,b"[]",t,c,&[0;32],marker);}

#[cfg(explicit_unsafe)]
pub fn attempt(p:&prepared_json_native_v10::Prepared,t:&mut[prepared_json_native_v10::NativeText],c:&mut[prepared_json_native_v10::NativeValue]){let _=unsafe{prepared_json_native_v10::evaluate(p,b"[]",t,c,&[0;32],marker)};}

#[cfg(old_program_to10)]
pub fn attempt(p:&typed_record::PreparedJsonProgram){let _=typed_record::prepare_json_arguments_v10(p,b"[]");}

#[cfg(new_program_to8)]
pub fn attempt(p:&typed_record::PreparedJsonProgramV10){let _=typed_record::prepare_json_arguments_v8(p,b"[]");}

#[cfg(old_invocation_to10)]
pub fn attempt(p:&typed_record::PreparedJsonInvocation<'_>){let _=typed_record::evaluate_prepared_json_v10(p);}

#[cfg(new_invocation_to8)]
pub fn attempt(p:&typed_record::PreparedJsonInvocationV10<'_>){let _=typed_record::evaluate_prepared_json_v8(p);}

