fn bounded_read(path:&str,limit:usize)->Vec<u8>{
 use std::io::Read;
 let file=std::fs::File::open(path).unwrap();let meta=file.metadata().unwrap();
 assert!(meta.is_file()&&meta.len()<=limit as u64);
 let mut bytes=Vec::new();file.take(limit as u64+1).read_to_end(&mut bytes).unwrap();
 assert!(bytes.len()<=limit);bytes
}


fn main(){
 let a:Vec<_>=std::env::args().collect();assert!(a.len()>=4);assert!(["run","admit","inspect","batch"].contains(&a[2].as_str()));assert!(a[2]=="batch"||a.len()==4);
 let source=bounded_read(&a[1],1048576);
 let p=match typed_record::prepare_json_program_v10(&source){Ok(p)=>p,Err(e)=>{println!("PREPARE:{e}");return;}};
 if a[2]=="inspect"{println!("{} {}",p.source().canonical_bytes().len(),p.source_values());return;}
 for path in &a[3..]{
  let raw=bounded_read(path,1048576);
  match typed_record::prepare_json_arguments_v10(&p,&raw){
   Err(e)=>println!("ARGUMENTS:{e}"),
   Ok(i)=>{if a[2]=="admit"{println!("ADMITTED");}else{
    let out=typed_record::evaluate_prepared_json_v10(&i).unwrap();
    if a[2]=="batch"{let text=out.iter().map(|b|format!("{b:02x}")).collect::<String>();println!("{text}");}
    else{use std::io::Write;std::io::stdout().write_all(&out).unwrap();}
   }}
  }
 }
}
