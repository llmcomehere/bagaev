#[test] fn aggregate4097(){let big="😀".repeat(256);let b=frame(&[big.as_bytes(),big.as_bytes(),big.as_bytes(),big.as_bytes(),b"x"]);let e=list_callframe::decode(&b,&[list_callframe::Type::TextList]).err().unwrap();assert_eq!((e.reason,e.offset),("LIST_BYTES",68));}
#[test] fn ascii257(){let a=[b'a';257];let b=frame(&[&a]);let e=list_callframe::decode(&b,&[list_callframe::Type::TextList]).err().unwrap();assert_eq!((e.reason,e.offset),("LIST_TEXT",544));}
#[test] fn empty_elements(){let b=frame(&[b"",b"",b""]);let a=list_callframe::decode(&b,&[list_callframe::Type::TextList]).unwrap();match a.get(0).unwrap(){list_callframe::Value::List(v)=>{assert_eq!(v.len(),3);for i in 0..3{assert_eq!(v.get(i).unwrap().bytes(),b"");}},_=>panic!("wrong type")}}
#[test] fn short_frame(){let b=frame(&[]);let e=list_callframe::decode(&b[..37007],&[list_callframe::Type::TextList]).err().unwrap();assert_eq!((e.reason,e.offset),("FRAME_SIZE",0));}
#[test] fn long_signature(){let b=frame(&[]);let e=list_callframe::decode(&b,&[list_callframe::Type::TextList;9]).err().unwrap();assert_eq!((e.reason,e.offset),("SIGNATURE",8));}
fn scalar(tag:u32,len:u32)->Vec<u8>{let mut b=frame(&[]);b[16..20].copy_from_slice(&tag.to_le_bytes());b[20..24].copy_from_slice(&len.to_le_bytes());b}
#[test] fn int_zero(){let b=scalar(1,8);let a=list_callframe::decode(&b,&[list_callframe::Type::Int64]).unwrap();match a.get(0).unwrap(){list_callframe::Value::Int64(v)=>assert_eq!(v,0),_=>panic!("wrong type")}}
#[test] fn bool_bad(){let mut b=scalar(2,1);b[24]=2;let e=list_callframe::decode(&b,&[list_callframe::Type::Bool]).err().unwrap();assert_eq!((e.reason,e.offset),("BOOL_VALUE",24));}
#[test] fn option_some_zero(){let mut b=scalar(4,16);b[24]=1;let a=list_callframe::decode(&b,&[list_callframe::Type::OptionInt64]).unwrap();match a.get(0).unwrap(){list_callframe::Value::Optional(v)=>assert_eq!(v.value(),Some(0)),_=>panic!("wrong type")}}
