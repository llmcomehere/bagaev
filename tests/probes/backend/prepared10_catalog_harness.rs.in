use std::io::Write;use std::sync::atomic::{AtomicU8,AtomicU64,Ordering};static CALLS:AtomicU64=AtomicU64::new(0);static FILL:AtomicU8=AtomicU8::new(0);static USED:AtomicU64=AtomicU64::new(0);static TEXT_USED:AtomicU64=AtomicU64::new(0);use json_native_adapter_v10::{NativeValue,NativeText,KernelOutput,Cells,Arena};use json_native_input::Node;
extern "C"{fn bagaev_json_view10_kernel(v:*const NativeValue,a:*mut Arena,c:*mut Cells,o:*mut KernelOutput);}
fn words(v:NativeValue)->(i64,usize,u64,u64){(v.scalar,v.bytes as usize,v.len,v.scalars)}
unsafe fn snapshot(root:*const Node)->Vec<u8>{let mut out=Vec::new();let mut pending=vec![root];let mut seen=0;while let Some(p)=pending.pop(){seen+=1;assert!(seen<=16384);let n=unsafe{&*p};for x in [n.kind,n.count,n.int_charge,n.int_valid,n.int_payload as u64,n.text as usize as u64,n.text_bytes,n.text_scalars,n.entries as usize as u64,n.reserved]{out.extend_from_slice(&x.to_le_bytes());}if !n.text.is_null(){out.extend_from_slice(unsafe{std::slice::from_raw_parts(n.text,n.text_bytes as usize)});}if n.count>0{let entries=unsafe{std::slice::from_raw_parts(n.entries,n.count as usize)};for e in entries{for x in [e.key as usize as u64,e.key_bytes,e.child as usize as u64]{out.extend_from_slice(&x.to_le_bytes());}if !e.key.is_null(){out.extend_from_slice(unsafe{std::slice::from_raw_parts(e.key,e.key_bytes as usize)});}pending.push(e.child);}}}out}
unsafe extern "C" fn measured(v:*const NativeValue,a:*mut Arena,c:*mut Cells,o:*mut KernelOutput){let argument=unsafe{v.read()};let root=argument.bytes.cast::<Node>();let before=unsafe{snapshot(root)};let f=FILL.load(Ordering::SeqCst);let u=u64::from_le_bytes([f;8]);let q=u32::from_le_bytes([f;4]);let mut out=KernelOutput{meta:composite_export_v10::Output{status:q,value_type:q,value:u as i64,work:u,reason:q,location:q},value:NativeValue{scalar:u as i64,bytes:u as usize as *const u8,len:u,scalars:u}};CALLS.fetch_add(1,Ordering::SeqCst);unsafe{bagaev_json_view10_kernel(v,a,c,&mut out);o.write(out);}assert_eq!(before,unsafe{snapshot(root)});assert_eq!(words(argument),words(unsafe{v.read()}));USED.store(unsafe{(*c).used},Ordering::SeqCst);TEXT_USED.store(unsafe{(*a).used},Ordering::SeqCst);}

fn bounded_read(path:&str,limit:usize)->Vec<u8>{
 use std::io::Read;
 let file=std::fs::File::open(path).unwrap();let meta=file.metadata().unwrap();
 assert!(meta.is_file()&&meta.len()<=limit as u64);
 let mut bytes=Vec::new();file.take(limit as u64+1).read_to_end(&mut bytes).unwrap();
 assert!(bytes.len()<=limit);bytes
}

fn main(){let args:Vec<_>=std::env::args().collect();assert_eq!(args.len(),4);let raw=bounded_read(&args[1],1048576);let prepared=prepared_json_native_v10::prepare(include_bytes!("{{CATALOG_SOURCE}}")).unwrap();let fill:u8=args[2].parse().unwrap();assert!(fill==90||fill==165);FILL.store(fill,Ordering::SeqCst);let bytes={let u=u64::from_le_bytes([fill;8]);let dirty=NativeValue{scalar:u as i64,bytes:u as usize as *const u8,len:u,scalars:u};let guard=NativeValue{scalar:17,bytes:std::ptr::null(),len:19,scalars:23};let mut cells=vec![dirty;65538];cells[0]=guard;cells[65537]=guard;let tg=NativeText{bytes:std::ptr::null(),len:31,scalars:37};let mut text=vec![NativeText::zero();65538];text[0]=tg;text[65537]=tg;
let binding=[196,183,203,139,39,126,125,92,46,152,122,24,205,179,187,179,186,91,66,45,159,190,228,185,139,174,187,132,126,90,248,12];assert_eq!(sha256::digest(prepared.source().source().canonical_bytes()),"sha256:c4b7cb8b277e7d5c2e987a18cdb3bbb3ba5b422d9fbee4b98baebb847e5af80c");let owned=unsafe{prepared_json_native_v10::evaluate(&prepared,&raw,&mut text[1..65537],&mut cells[1..65537],&binding,measured)}.unwrap();assert_eq!(CALLS.load(Ordering::SeqCst),1);assert_eq!(owned.meta.work,args[3].parse::<u64>().unwrap());assert!(USED.load(Ordering::SeqCst)<=65536);assert!(TEXT_USED.load(Ordering::SeqCst)<=65536);for i in [0,65537]{assert_eq!(words(cells[i]),words(guard));assert_eq!((text[i].bytes,text[i].len,text[i].scalars),(tg.bytes,tg.len,tg.scalars));}for v in &cells[1+USED.load(Ordering::SeqCst) as usize..65537]{assert_eq!(words(*v),words(dirty));}for v in &text[1+TEXT_USED.load(Ordering::SeqCst) as usize..65537]{assert_eq!((v.bytes,v.len,v.scalars),(std::ptr::null(),0,0));}use type_graph::{Ref,Definition};use record_value::Kind;let entry_fields=[Ref::Primitive(Kind::OptionInt64),Ref::Primitive(Kind::Text),Ref::Primitive(Kind::TextList),Ref::Primitive(Kind::TextList),Ref::Primitive(Kind::Text)];let refusal_fields=[Ref::Primitive(Kind::Text),Ref::Primitive(Kind::Text)];let state_fields=[Ref::Named(4)];let success_fields=[Ref::Primitive(Kind::TextList),Ref::Primitive(Kind::Text),Ref::Named(2)];let alternatives=[Ref::Named(1),Ref::Named(3)];let graph=[Definition::Product(&entry_fields),Definition::Product(&refusal_fields),Definition::Product(&state_fields),Definition::Product(&success_fields),Definition::List{element:Ref::Named(0),capacity:4},Definition::Sum(&alternatives)];composite_result_decode_v10::decode(&graph,Ref::Named(5),&owned.bytes,&binding).unwrap();owned.bytes};drop(raw);drop(prepared);std::io::stdout().write_all(&bytes).unwrap();}