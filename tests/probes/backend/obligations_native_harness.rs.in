use std::io::Write;use std::sync::atomic::{AtomicU8,AtomicU64,Ordering};static FILL:AtomicU8=AtomicU8::new(0);static USED:AtomicU64=AtomicU64::new(0);static TEXT_USED:AtomicU64=AtomicU64::new(0);use json_native_adapter_v8::{NativeValue,NativeText,KernelOutput,Cells,Arena};use json_native_input::Node;
extern "C"{fn bagaev_json_view8_kernel(v:*const NativeValue,a:*mut Arena,c:*mut Cells,o:*mut KernelOutput);}
fn words(v:NativeValue)->(i64,usize,u64,u64){(v.scalar,v.bytes as usize,v.len,v.scalars)}
unsafe fn snapshot(root:*const Node)->Vec<u8>{let mut out=Vec::new();let mut pending=vec![root];let mut seen=0;while let Some(p)=pending.pop(){seen+=1;assert!(seen<=16384);let n=unsafe{&*p};for x in [n.kind,n.count,n.int_charge,n.int_valid,n.int_payload as u64,n.text as usize as u64,n.text_bytes,n.text_scalars,n.entries as usize as u64,n.reserved]{out.extend_from_slice(&x.to_le_bytes());}if !n.text.is_null(){out.extend_from_slice(unsafe{std::slice::from_raw_parts(n.text,n.text_bytes as usize)});}if n.count>0{let entries=unsafe{std::slice::from_raw_parts(n.entries,n.count as usize)};for e in entries{for x in [e.key as usize as u64,e.key_bytes,e.child as usize as u64]{out.extend_from_slice(&x.to_le_bytes());}if !e.key.is_null(){out.extend_from_slice(unsafe{std::slice::from_raw_parts(e.key,e.key_bytes as usize)});}pending.push(e.child);}}}out}

static CALLS:AtomicU64=AtomicU64::new(0);
unsafe extern "C" fn measured(v:*const NativeValue,a:*mut Arena,c:*mut Cells,o:*mut KernelOutput){
 let arguments=[unsafe{v.read()},unsafe{v.add(1).read()}];
 let before=[unsafe{snapshot(arguments[0].bytes.cast::<Node>())},unsafe{snapshot(arguments[1].bytes.cast::<Node>())}];
 let f=FILL.load(Ordering::SeqCst);let u=u64::from_le_bytes([f;8]);let q=u32::from_le_bytes([f;4]);
 let mut out=KernelOutput{meta:composite_export_v8::Output{status:q,value_type:q,value:u as i64,work:u,reason:q,location:q},value:NativeValue{scalar:u as i64,bytes:u as usize as *const u8,len:u,scalars:u}};
 CALLS.fetch_add(1,Ordering::SeqCst);
 unsafe{bagaev_json_view8_kernel(v,a,c,&mut out);o.write(out);}
 for i in 0..2{assert_eq!(before[i],unsafe{snapshot(arguments[i].bytes.cast::<Node>())});assert_eq!(words(arguments[i]),words(unsafe{v.add(i).read()}));}
 USED.store(unsafe{(*c).used},Ordering::SeqCst);TEXT_USED.store(unsafe{(*a).used},Ordering::SeqCst);
}
fn bounded_read(path:&str)->Vec<u8>{use std::io::Read;let f=std::fs::File::open(path).unwrap();let meta=f.metadata().unwrap();assert!(meta.is_file()&&meta.len()<=1048576);let mut raw=Vec::new();f.take(1048577).read_to_end(&mut raw).unwrap();assert!(raw.len()<=1048576);raw}
fn main(){
 let args:Vec<_>=std::env::args().collect();assert_eq!(args.len(),4);
 let raw=bounded_read(&args[1]);
 let checked=typed_record::checked_json_invocation_v8(&raw).unwrap();
 assert_eq!(sha256::digest(checked.program().canonical_bytes()),"sha256:476b63d497c6a00a38377002cd16b05f41c36e281bbe55e145ab80ec48dd3341");
 assert_eq!(checked.json_arguments().len(),2);drop(checked);
 let fill:u8=args[2].parse().unwrap();assert!(fill==90||fill==165);FILL.store(fill,Ordering::SeqCst);
 let bytes={
  let u=u64::from_le_bytes([fill;8]);let dirty=NativeValue{scalar:u as i64,bytes:u as usize as *const u8,len:u,scalars:u};
  let guard=NativeValue{scalar:17,bytes:std::ptr::null(),len:19,scalars:23};
  let mut cells=vec![dirty;65538];cells[0]=guard;cells[65537]=guard;
  let tg=NativeText{bytes:std::ptr::null(),len:31,scalars:37};
  let mut text=vec![NativeText::zero();65538];text[0]=tg;text[65537]=tg;
let binding=[187,148,226,239,76,121,54,230,207,231,160,66,178,87,206,13,250,117,72,153,23,226,6,45,180,225,50,86,33,54,40,4];

  let owned=unsafe{json_native_adapter_v8::evaluate(&raw,&mut text[1..65537],&mut cells[1..65537],&binding,measured)}.unwrap();
  assert_eq!(CALLS.load(Ordering::SeqCst),1);assert_eq!(owned.meta.work,args[3].parse::<u64>().unwrap());
  let used=USED.load(Ordering::SeqCst);let text_used=TEXT_USED.load(Ordering::SeqCst);assert!(used<=65536&&text_used<=65536);
  for i in [0,65537]{assert_eq!(words(cells[i]),words(guard));assert_eq!((text[i].bytes,text[i].len,text[i].scalars),(tg.bytes,tg.len,tg.scalars));}
  for v in &cells[1+used as usize..65537]{assert_eq!(words(*v),words(dirty));}
  for v in &text[1+text_used as usize..65537]{assert_eq!((v.bytes,v.len,v.scalars),(std::ptr::null(),0,0));}
  use type_graph::{Ref,Definition};use record_value::Kind;
  let fields=[Ref::Primitive(Kind::Text),Ref::Primitive(Kind::Text)];let graph=[Definition::Product(&fields)];
  composite_result_decode::decode(&graph,Ref::Named(0),&owned.bytes,&binding).unwrap();owned.bytes
 };drop(raw);std::io::stdout().write_all(&bytes).unwrap();
}
