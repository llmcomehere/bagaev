use std::io::Write;use std::sync::atomic::{AtomicU8,AtomicU64,Ordering};static FILL:AtomicU8=AtomicU8::new(0);static USED:AtomicU64=AtomicU64::new(0);static TEXT_USED:AtomicU64=AtomicU64::new(0);use json_native_adapter_v9::{NativeValue,NativeText,KernelOutput,Cells,Arena};use json_native_input::Node;
extern "C"{fn bagaev_json_view9_kernel(v:*const NativeValue,a:*mut Arena,c:*mut Cells,o:*mut KernelOutput);}
fn words(v:NativeValue)->(i64,usize,u64,u64){(v.scalar,v.bytes as usize,v.len,v.scalars)}
unsafe fn snapshot(root:*const Node)->Vec<u8>{let mut out=Vec::new();let mut pending=vec![root];let mut seen=0;while let Some(p)=pending.pop(){seen+=1;assert!(seen<=16384);let n=unsafe{&*p};for x in [n.kind,n.count,n.int_charge,n.int_valid,n.int_payload as u64,n.text as usize as u64,n.text_bytes,n.text_scalars,n.entries as usize as u64,n.reserved]{out.extend_from_slice(&x.to_le_bytes());}if !n.text.is_null(){out.extend_from_slice(unsafe{std::slice::from_raw_parts(n.text,n.text_bytes as usize)});}if n.count>0{let entries=unsafe{std::slice::from_raw_parts(n.entries,n.count as usize)};for e in entries{for x in [e.key as usize as u64,e.key_bytes,e.child as usize as u64]{out.extend_from_slice(&x.to_le_bytes());}if !e.key.is_null(){out.extend_from_slice(unsafe{std::slice::from_raw_parts(e.key,e.key_bytes as usize)});}pending.push(e.child);}}}out}

static CALLS:AtomicU64=AtomicU64::new(0);
unsafe extern "C" fn measured(v:*const NativeValue,a:*mut Arena,c:*mut Cells,o:*mut KernelOutput){
 let f=FILL.load(Ordering::SeqCst);let u=u64::from_le_bytes([f;8]);let q=u32::from_le_bytes([f;4]);
 let mut out=KernelOutput{meta:composite_export_v9::Output{status:q,value_type:q,value:u as i64,work:u,reason:q,location:q},value:NativeValue{scalar:u as i64,bytes:u as usize as *const u8,len:u,scalars:u}};
 CALLS.fetch_add(1,Ordering::SeqCst);unsafe{bagaev_json_view9_kernel(v,a,c,&mut out);o.write(out);}
 USED.store(unsafe{(*c).used},Ordering::SeqCst);TEXT_USED.store(unsafe{(*a).used},Ordering::SeqCst);
}
fn main(){let args:Vec<_>=std::env::args().collect();let raw=std::fs::read(&args[1]).unwrap();let checked=typed_record::checked_json_invocation_v9(&raw).unwrap();assert_eq!(checked.program().canonical_bytes(),&{{CANONICAL_BYTES}});assert_eq!(checked.json_arguments().len(),0);
 let fill:u8=args[2].parse().unwrap();assert!(fill==90||fill==165);FILL.store(fill,Ordering::SeqCst);
let expected_path={{EXPECTED_PATH}};
let binding={{SOURCE_BINDING}};

 let location=if expected_path.is_empty(){0}else{checked.program().nodes().iter().find(|n|format!("/program{}",n.pointer())==expected_path).unwrap().id() as u32};drop(checked);
 let bytes={let u=u64::from_le_bytes([fill;8]);let dirty=NativeValue{scalar:u as i64,bytes:u as usize as *const u8,len:u,scalars:u};let guard=NativeValue{scalar:17,bytes:std::ptr::null(),len:19,scalars:23};let mut cells=vec![dirty;65538];cells[0]=guard;cells[65537]=guard;
 let dirtytext=NativeText{bytes:u as usize as *const u8,len:u,scalars:u};let tg=NativeText{bytes:std::ptr::null(),len:31,scalars:37};let mut text=vec![dirtytext;65538];text[0]=tg;text[65537]=tg;
 let owned=unsafe{json_native_adapter_v9::evaluate(&raw,&mut text[1..65537],&mut cells[1..65537],&binding,measured)}.unwrap();assert_eq!(CALLS.load(Ordering::SeqCst),1);
assert_eq!((owned.meta.status,owned.meta.reason,owned.meta.work,owned.meta.location),({{STATUS}},{{REASON}},{{WORK}},location));

 let used=USED.load(Ordering::SeqCst)as usize;let tu=TEXT_USED.load(Ordering::SeqCst)as usize;assert!(used<=65536&&tu<=65536);
 for i in [0,65537]{assert_eq!(words(cells[i]),words(guard));assert_eq!((text[i].bytes,text[i].len,text[i].scalars),(tg.bytes,tg.len,tg.scalars));}
 for v in &cells[1+used..65537]{assert_eq!(words(*v),words(dirty));}
 for v in &text[1+tu..65537]{assert_eq!((v.bytes,v.len,v.scalars),(dirtytext.bytes,dirtytext.len,dirtytext.scalars));}
 owned.bytes};drop(raw);assert_eq!(bytes.as_slice(),&{{EXPECTED_WIRE}});std::io::stdout().write_all(&bytes).unwrap();}
