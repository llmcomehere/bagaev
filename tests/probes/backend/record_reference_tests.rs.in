// Data-only portable tests. Substitute {{BACKEND}} with a reviewed source directory.
// Compilation/execution requires its own approved bounded profile.
#[path="{{BACKEND}}/transport.rs"]pub mod transport;
#[path="{{BACKEND}}/check.rs"]pub mod check;
#[path="{{BACKEND}}/ir.rs"]pub mod ir;
#[path="{{BACKEND}}/canonical.rs"]pub mod canonical;
#[path="{{BACKEND}}/sha256.rs"]pub mod sha256;
