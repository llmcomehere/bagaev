#[path="{{BACKEND}}/text_list.rs"]pub mod text_list;
#[path="{{BACKEND}}/typed_record.rs"]pub mod typed_record;
#[test]fn case_0(){let input="{\"schema\":\"bagaev-typed-record-invocation/1\",\"program\":{\"schema\":\"bagaev-typed-record/1\",\"records\":{\"Pair\":{\"flag\":\"Bool\",\"n\":\"Int64\"}},\"entry\":\"main\",\"functions\":{\"main\":{\"params\":[],\"result\":\"Int64\",\"body\":[\"field\",[\"record\",\"Pair\",[\"bool\",true],[\"int\",7]],\"n\"]}}},\"arguments\":[]}";let expected="{\"location\":null,\"reason\":null,\"schema\":\"bagaev-typed-record-result/1\",\"status\":\"success\",\"value\":7,\"value_type\":\"Int64\",\"work\":4}\n";assert_eq!(typed_record::process(input.as_bytes()).unwrap(),expected.as_bytes(),"typed-record-r1 FIELD");}
#[test]fn case_1(){let input="{\"schema\":\"bagaev-typed-record-invocation/1\",\"program\":{\"schema\":\"bagaev-typed-record/1\",\"records\":{\"Empty\":{}},\"entry\":\"main\",\"functions\":{\"main\":{\"params\":[],\"result\":\"Int64\",\"body\":[\"let\",\"x\",[\"record\",\"Empty\"],[\"int\",3]]}}},\"arguments\":[]}";let expected="{\"location\":null,\"reason\":null,\"schema\":\"bagaev-typed-record-result/1\",\"status\":\"success\",\"value\":3,\"value_type\":\"Int64\",\"work\":3}\n";assert_eq!(typed_record::process(input.as_bytes()).unwrap(),expected.as_bytes(),"typed-record-r1 EMPTY");}
#[test]fn case_2(){let input="{\"schema\":\"bagaev-typed-record-invocation/1\",\"program\":{\"schema\":\"bagaev-typed-record/1\",\"records\":{\"T\":{\"s\":\"Text\"}},\"entry\":\"main\",\"functions\":{\"main\":{\"params\":[],\"result\":\"Int64\",\"body\":[\"text.bytes\",[\"field\",[\"record\",\"T\",[\"text\",\"\\u00e9\"]],\"s\"]]}}},\"arguments\":[]}";let expected="{\"location\":null,\"reason\":null,\"schema\":\"bagaev-typed-record-result/1\",\"status\":\"success\",\"value\":2,\"value_type\":\"Int64\",\"work\":6}\n";assert_eq!(typed_record::process(input.as_bytes()).unwrap(),expected.as_bytes(),"typed-record-r1 TEXT");}
#[test]fn case_3(){let input="{\"schema\":\"bagaev-typed-record-invocation/1\",\"program\":{\"schema\":\"bagaev-typed-record/1\",\"records\":{\"O\":{\"x\":\"OptionInt64\"}},\"entry\":\"main\",\"functions\":{\"main\":{\"params\":[],\"result\":\"Int64\",\"body\":[\"option.or\",[\"field\",[\"record\",\"O\",[\"none.int\"]],\"x\"],[\"int\",9]]}}},\"arguments\":[]}";let expected="{\"location\":null,\"reason\":null,\"schema\":\"bagaev-typed-record-result/1\",\"status\":\"success\",\"value\":9,\"value_type\":\"Int64\",\"work\":5}\n";assert_eq!(typed_record::process(input.as_bytes()).unwrap(),expected.as_bytes(),"typed-record-r1 NONE");}
#[test]fn case_4(){let input="{\"schema\":\"bagaev-typed-record-invocation/1\",\"program\":{\"schema\":\"bagaev-typed-record/1\",\"records\":{\"O\":{\"x\":\"OptionInt64\"}},\"entry\":\"main\",\"functions\":{\"main\":{\"params\":[],\"result\":\"Int64\",\"body\":[\"option.or\",[\"field\",[\"record\",\"O\",[\"some.int\",[\"int\",0]]],\"x\"],[\"add\",[\"int\",9223372036854775807],[\"int\",1]]]}}},\"arguments\":[]}";let expected="{\"location\":null,\"reason\":null,\"schema\":\"bagaev-typed-record-result/1\",\"status\":\"success\",\"value\":0,\"value_type\":\"Int64\",\"work\":5}\n";assert_eq!(typed_record::process(input.as_bytes()).unwrap(),expected.as_bytes(),"typed-record-r1 ZERO-LAZY");}
#[test]fn case_5(){let input="{\"schema\":\"bagaev-typed-record-invocation/1\",\"program\":{\"schema\":\"bagaev-typed-record/1\",\"records\":{\"A\":{\"n\":\"Int64\"}},\"entry\":\"main\",\"functions\":{\"main\":{\"params\":[],\"result\":\"Int64\",\"body\":[\"field\",[\"if\",[\"bool\",false],[\"record\",\"A\",[\"int\",1]],[\"record\",\"A\",[\"int\",2]]],\"n\"]}}},\"arguments\":[]}";let expected="{\"location\":null,\"reason\":null,\"schema\":\"bagaev-typed-record-result/1\",\"status\":\"success\",\"value\":2,\"value_type\":\"Int64\",\"work\":5}\n";assert_eq!(typed_record::process(input.as_bytes()).unwrap(),expected.as_bytes(),"typed-record-r1 BRANCH");}
#[test]fn case_6(){let input="{\"schema\":\"bagaev-typed-record-invocation/1\",\"program\":{\"schema\":\"bagaev-typed-record/1\",\"records\":{\"A\":{\"n\":\"Int64\"}},\"entry\":\"main\",\"functions\":{\"main\":{\"params\":[],\"result\":\"Int64\",\"body\":[\"field\",[\"loop\",2,\"i\",\"a\",[\"record\",\"A\",[\"int\",0]],[\"record\",\"A\",[\"add\",[\"field\",[\"use\",\"a\"],\"n\"],[\"int\",1]]]],\"n\"]}}},\"arguments\":[]}";let expected="{\"location\":null,\"reason\":null,\"schema\":\"bagaev-typed-record-result/1\",\"status\":\"success\",\"value\":2,\"value_type\":\"Int64\",\"work\":14}\n";assert_eq!(typed_record::process(input.as_bytes()).unwrap(),expected.as_bytes(),"typed-record-r1 LOOP");}
