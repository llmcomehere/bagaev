{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bagaev:proposed:lifecycle-wire:0.2",
  "title": "bagaev R16 proposed lifecycle envelopes",
  "$comment": "Shape only. Raw duplicate fields, UTF-8, CJ-INT-1, total bytes/depth/nodes, ref authenticity, current authority and lifecycle semantics require independent guards. This is not the complete T12 operations schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/CommandEnvelope"
    },
    {
      "$ref": "#/$defs/ResumeRequest"
    },
    {
      "$ref": "#/$defs/MaintenanceCommand"
    },
    {
      "$ref": "#/$defs/RecoveryRequest"
    },
    {
      "$ref": "#/$defs/Reply"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+(?![\\s\\S])"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "Counter": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])"
    },
    "PositiveCounter": {
      "allOf": [
        {
          "$ref": "#/$defs/Counter"
        },
        {
          "pattern": "^[1-9][0-9]*(?![\\s\\S])"
        }
      ]
    },
    "Key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "WorkRef": {
      "type": "object",
      "properties": {
        "work_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "work_id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "JournalHead": {
      "type": "object",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/Counter"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "sequence",
        "sha256"
      ],
      "additionalProperties": false
    },
    "WorkCursor": {
      "type": "object",
      "properties": {
        "work_ref": {
          "$ref": "#/$defs/WorkRef"
        },
        "journal_head": {
          "$ref": "#/$defs/JournalHead"
        }
      },
      "required": [
        "work_ref",
        "journal_head"
      ],
      "additionalProperties": false
    },
    "KeyRef": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "namespace_id": {
          "$ref": "#/$defs/Id"
        },
        "generation": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "key": {
          "$ref": "#/$defs/Key"
        }
      },
      "required": [
        "project_id",
        "namespace_id",
        "generation",
        "key"
      ],
      "additionalProperties": false
    },
    "CommandEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "bagaev-lifecycle-command/0.2"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "key_ref": {
          "$ref": "#/$defs/KeyRef"
        },
        "operation": {
          "$ref": "#/$defs/Id"
        },
        "operation_revision": {
          "$ref": "#/$defs/Id"
        },
        "work_ref": {
          "$ref": "#/$defs/WorkRef"
        },
        "target_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "policy_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "arguments_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "schema",
        "request_id",
        "key_ref",
        "operation",
        "operation_revision",
        "work_ref",
        "target_ref",
        "policy_ref",
        "arguments_ref"
      ],
      "additionalProperties": false
    },
    "ResumeRequest": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "bagaev-lifecycle-resume/0.2"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "work_id": {
          "$ref": "#/$defs/Id"
        },
        "checkpoint_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "selected_journal_head": {
          "anyOf": [
            {
              "$ref": "#/$defs/JournalHead"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "request_id",
        "project_id",
        "work_id",
        "checkpoint_ref",
        "selected_journal_head",
        "page_size",
        "continuation"
      ],
      "additionalProperties": false
    },
    "MaintenanceIntentRef": {
      "type": "object",
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/Id"
        },
        "authority_epoch": {
          "$ref": "#/$defs/PositiveCounter"
        },
        "sequence": {
          "$ref": "#/$defs/PositiveCounter"
        }
      },
      "required": [
        "authority_id",
        "authority_epoch",
        "sequence"
      ],
      "additionalProperties": false
    },
    "MaintenanceCommand": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "bagaev-lifecycle-maintenance/0.2"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "intent_ref": {
          "$ref": "#/$defs/MaintenanceIntentRef"
        },
        "operation": {
          "enum": [
            "namespace.allocate",
            "generation.rotate",
            "generation.retire",
            "receipts.collect",
            "policy.update",
            "worker.takeover",
            "recovery.activate",
            "recovery.burn"
          ]
        },
        "expected_control_head": {
          "$ref": "#/$defs/JournalHead"
        },
        "scope_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "policy_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "arguments_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "schema",
        "request_id",
        "intent_ref",
        "operation",
        "expected_control_head",
        "scope_ref",
        "policy_ref",
        "arguments_ref"
      ],
      "additionalProperties": false
    },
    "RecoveryRequest": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "bagaev-lifecycle-recovery/0.2"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "maintenance_intent_ref": {
          "$ref": "#/$defs/MaintenanceIntentRef"
        },
        "scope_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "admitted_certificate_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "request_id",
        "maintenance_intent_ref",
        "scope_ref",
        "manifest_ref",
        "admitted_certificate_ref"
      ],
      "additionalProperties": false
    },
    "ReconciliationEvidenceRef": {
      "type": "object",
      "properties": {
        "effect_intent_id": {
          "$ref": "#/$defs/Id"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "target_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "adapter_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evidence_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "effect_intent_id",
        "request_digest",
        "target_ref",
        "adapter_ref",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "Reply": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "bagaev-lifecycle-reply/0.2"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "code": {
          "enum": [
            "ADMITTED",
            "REPLAY",
            "PENDING",
            "COMMITTED",
            "REJECTED",
            "RESUME_VIEW",
            "IDEMPOTENCY_CONFLICT",
            "KEY_EXPIRED",
            "KEY_ADMISSION_CLOSED",
            "KEY_NOT_ISSUED",
            "EFFECT_UNKNOWN",
            "STALE_OWNER",
            "LEASE_EXPIRED",
            "STALE_WORK",
            "STALE_POLICY",
            "RECOVERY_REQUIRED",
            "JOURNAL_GAP",
            "INTEGRITY_ERROR",
            "ARCHIVE_UNAVAILABLE",
            "STORAGE_PRESSURE",
            "ADMISSION_PAUSED",
            "TIME_UNCERTAIN",
            "COUNTER_EXHAUSTED",
            "UNSUPPORTED_OPERATION_REVISION",
            "UNSUPPORTED_CHECKPOINT",
            "CHECKPOINT_DIVERGED",
            "FORBIDDEN",
            "INVALID_INPUT",
            "INPUT_LIMIT",
            "WORK_CONFLICT",
            "EFFECT_EVIDENCE_MISMATCH",
            "UNSUPPORTED_RECONCILIATION",
            "EFFECT_EVIDENCE_CONFLICT"
          ]
        },
        "key_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "namespace_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "admitted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_availability": {
          "enum": [
            "NONE",
            "RETAINED",
            "ARCHIVED",
            "EXPIRED",
            "UNKNOWN"
          ]
        },
        "effect_outcome": {
          "enum": [
            "UNOBSERVED",
            "NOT_STARTED",
            "UNKNOWN",
            "CONFIRMED_APPLIED",
            "CONFIRMED_NOT_APPLIED"
          ]
        },
        "work_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "blocker_inventory_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "repeat_same_request": {
          "enum": [
            "ALLOWED",
            "STATUS_ONLY",
            "FORBIDDEN"
          ]
        },
        "retry_new_key": {
          "const": false
        }
      },
      "required": [
        "schema",
        "request_id",
        "code",
        "key_ref",
        "namespace_ref",
        "admitted",
        "receipt_ref",
        "result_availability",
        "effect_outcome",
        "work_cursor",
        "blockers",
        "blocker_inventory_ref",
        "repeat_same_request",
        "retry_new_key"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "KEY_EXPIRED"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "admitted": {
                "type": "null"
              },
              "receipt_ref": {
                "type": "null"
              },
              "result_availability": {
                "enum": [
                  "EXPIRED",
                  "UNKNOWN"
                ]
              },
              "repeat_same_request": {
                "const": "FORBIDDEN"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "EFFECT_UNKNOWN"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "effect_outcome": {
                "const": "UNKNOWN"
              },
              "repeat_same_request": {
                "enum": [
                  "STATUS_ONLY",
                  "FORBIDDEN"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "REPLAY"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "admitted": {
                "const": true
              },
              "receipt_ref": {
                "$ref": "#/$defs/ArtifactRef"
              },
              "result_availability": {
                "enum": [
                  "RETAINED",
                  "ARCHIVED"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
