{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bagaev.local/spec/protocol/operations.schema.json",
  "title": "bagaev agent protocol (CHANGE-1): запрос и ответ",
  "$defs": {
    "key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "path": {"type": "string", "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*[.]bag$"},
    "read_op": {"enum": ["search", "inspect", "relations", "impact", "context", "why", "check", "run_tests", "work_resume"]},
    "write_op": {"enum": ["change_begin", "contract_update", "apply", "verify", "rebase", "accept", "abandon"]},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "operation"],
      "properties": {
        "protocol": {"const": "bagaev-protocol/1"},
        "operation": {"anyOf": [{"$ref": "#/$defs/read_op"}, {"$ref": "#/$defs/write_op"}]},
        "change_id": {"type": "string"},
        "expected_work_revision": {"type": "integer", "minimum": 1},
        "idempotency_key": {"$ref": "#/$defs/key"},
        "arguments": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"operation": {"$ref": "#/$defs/write_op"}}},
         "then": {"required": ["idempotency_key"]}},
        {"if": {"properties": {"operation": {"enum": ["contract_update", "apply", "verify", "rebase", "accept", "abandon"]}}},
         "then": {"required": ["change_id", "expected_work_revision"]}},
        {"if": {"properties": {"operation": {"enum": ["relations", "impact", "context", "why", "check", "run_tests", "work_resume"]}}},
         "then": {"required": ["change_id"]}}
      ]
    },
    "source_edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "object", "additionalProperties": false, "required": ["path", "base_sha256", "edits"],
               "properties": {"path": {"$ref": "#/$defs/path"}, "base_sha256": {"type": "string"},
                              "edits": {"type": "array", "minItems": 1, "items": {"oneOf": [
                                {"type": "object", "additionalProperties": false, "required": ["start", "end", "text"],
                                 "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0},
                                                "text": {"type": "string"}}},
                                {"type": "object", "additionalProperties": false, "required": ["old_text", "text"],
                                 "properties": {"old_text": {"type": "string", "minLength": 1}, "text": {"type": "string"}}}]}}}},
              {"type": "object", "additionalProperties": false, "required": ["path", "base_sha256", "whole_file"],
               "properties": {"path": {"$ref": "#/$defs/path"}, "base_sha256": {"type": "string"}, "whole_file": {"type": "string"}}},
              {"type": "object", "additionalProperties": false, "required": ["path", "base_sha256", "delete"],
               "properties": {"path": {"$ref": "#/$defs/path"}, "base_sha256": {"type": "string"}, "delete": {"const": true}}},
              {"type": "object", "additionalProperties": false, "required": ["path", "create"],
               "properties": {"path": {"$ref": "#/$defs/path"}, "create": {"type": "string"}}}
            ]
          }
        },
        "identity_ops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op"],
            "properties": {"op": {"enum": ["rename", "copy", "delete", "split", "merge"]}}
          }
        },
        "assign_ids": {"type": "boolean"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "operation", "status", "replayed"],
      "properties": {
        "protocol": {"const": "bagaev-protocol/1"},
        "operation": {"type": ["string", "null"]},
        "status": {"enum": ["succeeded", "blocked", "failed"]},
        "replayed": {"type": "boolean"},
        "change_id": {"type": ["string", "null"]},
        "work_revision": {"type": "integer"},
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "data", "retry"],
          "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "data": {"type": "object"},
                         "retry": {"enum": ["fix_request", "new_key", "new_decision"]}}
        }
      },
      "oneOf": [{"required": ["result"]}, {"required": ["error"]}]
    }
  },
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}]
}
